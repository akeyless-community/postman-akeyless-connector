# Akeyless API endpoint. Use https://api.akeyless.io or your Gateway REST API
# (for example https://gateway.example.com:8000/api/v2).
AKEYLESS_API_URL=https://api.akeyless.io

# Issuer printed by scripts/akeyless-setup-postman.sh
AKEYLESS_OIDC_ISSUER_URL=https://auth.akeyless.io/oidc/provider/acc-REPLACE_ME

# Public OIDC App client ID printed by the setup script
AKEYLESS_OIDC_CLIENT_ID=c-REPLACE_ME

# OAuth2/JWT authentication method Access ID printed by the setup script
AKEYLESS_JWT_ACCESS_ID=p-REPLACE_ME

# Optional. Default: openid email
AKEYLESS_OIDC_SCOPE=openid email

# Item used by akeyless-postman-verify (never printed)
AKEYLESS_ITEM_PATH=/path/to/secret
AKEYLESS_SECRET_KEY=
